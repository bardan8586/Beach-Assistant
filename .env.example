# ============================================================
# Beach Assistant – Environment variables reference
# Copy to .env in each folder (backend/, or project root for AI) as needed.
# You do NOT need API keys for the default (YOLO local) setup.
# ============================================================

# ---------- Backend (backend/.env) ----------
# If port 8000 is already used (Docker, nginx, etc.), run the API on another port, e.g.:
# PORT=8008
# Then point the frontend at the same host/port (VITE_API_URL / VITE_WS_URL) and set:
# BACKEND_URL=http://127.0.0.1:8008
# (BACKEND_URL is where the AI subprocess POSTs /api/data/ingest; defaults to http://127.0.0.1:$PORT when unset.)
# Max upload for /api/video/upload (default 50 MB). Frontend reads GET /api/video/limits.
# MAX_UPLOAD_VIDEO_BYTES=52428800
# MongoDB: only required if not using local MongoDB
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/beach_safety

# Default beach for /api/coastal/conditions (Open-Meteo; no API key). Override for your patrol site.
# BEACH_DEFAULT_LAT=-33.890842
# BEACH_DEFAULT_LON=151.274291
# BEACH_DEFAULT_LABEL=Bondi Beach, NSW

# ---------- AI pipeline (optional; defaults work) ----------
# DETECTOR_TYPE=yolo
# MODEL_NAME: if unset, uses fine-tuned runs/.../best.pt when present, else yolov8s.pt
# To force pretrained: MODEL_NAME=yolov8s.pt
# MODEL_NAME=yolov8s.pt
# BACKEND_URL=http://localhost:8000
# CAMERA_ID=cam_001
# SEND_TO_BACKEND=true
# SHOW_WINDOW=false
# ENABLE_POSE=true

# Only if you use Roboflow instead of local YOLO:
# DETECTOR_TYPE=roboflow
# ROBOFLOW_API_KEY=your_roboflow_api_key
# ROBOFLOW_MODEL_ID=your_model_id
# ROBOFLOW_VERSION=1

# ---------- Frontend (optional; defaults point to localhost:8000) ----------
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
