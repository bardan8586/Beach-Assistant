# ============================================================
# Beach Assistant – Environment variables reference
# Copy to .env in each folder (backend/, or project root for AI) as needed.
# You do NOT need API keys for the default (YOLO local) setup.
# ============================================================

# ---------- Backend (backend/.env) ----------
# MongoDB: only required if not using local MongoDB
# MONGODB_URL=mongodb://localhost:27017
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/beach_safety

# ---------- AI pipeline (optional; defaults work) ----------
# DETECTOR_TYPE=yolo
# MODEL_NAME=yolov8s.pt
# BACKEND_URL=http://localhost:8000
# CAMERA_ID=cam_001
# SEND_TO_BACKEND=true
# SHOW_WINDOW=false
# ENABLE_POSE=true

# Only if you use Roboflow instead of local YOLO:
# DETECTOR_TYPE=roboflow
# ROBOFLOW_API_KEY=your_roboflow_api_key
# ROBOFLOW_MODEL_ID=your_model_id
# ROBOFLOW_VERSION=1

# ---------- Frontend (optional; defaults point to localhost:8000) ----------
# VITE_API_URL=http://localhost:8000
# VITE_WS_URL=ws://localhost:8000
