# ============================================
# Beach Assistant - Git Ignore
# ============================================

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
env/
venv/
ENV/
.venv
env.bak/
venv.bak/

# -------------------- AI Models (LARGE FILES) --------------------
# YOLOv8 and other model files
*.pt
*.pth
*.onnx
*.weights
*.h5
*.pb
*.tflite
tests/models/*.pt
tests/models/*.pth

# -------------------- Datasets (LARGE FILES) --------------------
# Roboflow / training datasets (do not commit)
ai/datasets/

# -------------------- Training Runs (selectively keep figures) --------------------
# Ignore all runs by default
ai/runs/
!ai/runs/
ai/runs/*

# Keep the specific MAI600 run folder figures used in docs/report.md
!ai/runs/detect/
ai/runs/detect/*

!ai/runs/detect/runs-mai600/
ai/runs/detect/runs-mai600/*

!ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/
ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/*

!ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/*.png
!ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/*.jpg
!ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/args.yaml

# Never commit weights
ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/weights/

# Keep the repo small: only commit the specific run figures we reference
ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/train_batch1.jpg
ai/runs/detect/runs-mai600/roboflow_v2_yolov8n_e5/train_batch2.jpg

# -------------------- Test Data (LARGE FILES) --------------------
# Video files
tests/data/*.mp4
tests/data/*.avi
tests/data/*.mov
tests/data/*.mkv
tests/data/*.flv
tests/data/*.wmv

# Image sequences
tests/data/*.jpg
tests/data/*.jpeg
tests/data/*.png

# -------------------- Generated Data --------------------
# Tracking logs
tracking_log.csv
*.csv

# Heatmaps
heatmaps/
*.heatmap

# Snapshots
snapshots/
alerts/

# -------------------- Database --------------------
*.db
*.sqlite
*.sqlite3
*.db-journal

# MongoDB data
data/db/
mongo-data/

# -------------------- Logs --------------------
*.log
logs/
*.log.*

# -------------------- IDE & Editors --------------------
# VS Code
.vscode/
.history/

# PyCharm
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-project
*.sublime-workspace

# -------------------- OS Files --------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# -------------------- Environment Variables --------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# -------------------- Frontend (Node.js / React) --------------------
# Dependencies
node_modules/
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js

# Build outputs
frontend/build/
frontend/dist/
frontend/.next/
frontend/out/

# Misc
frontend/.DS_Store
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# -------------------- Docker --------------------
# Docker volumes
docker/data/
*.dockerignore.bak

# -------------------- Testing --------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# -------------------- Jupyter Notebooks --------------------
.ipynb_checkpoints
*.ipynb

# -------------------- Documentation --------------------
# Exclude all .md files EXCEPT those in docs/ folder
*.md
!docs/**/*.md
!README.md
# Sphinx documentation
docs/_build/

# -------------------- Temporary Files --------------------
tmp/
temp/
*.tmp
*.bak
*.backup
ai/Untitled

# -------------------- System Files --------------------
# Thumbnails
*.thumb

# ============================================
# Keep These (Whitelist)
# ============================================
# Keep empty directories
!tests/data/.gitkeep
!tests/models/.gitkeep
backend/uploads/
